# LLM provider — fixed once for the whole study (see docs/NL-KQL/MASTER_PLAN.md §20)
# Supported: ollama (local), anthropic, openai, azure_foundry
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434

# azure_foundry only — endpoint is the resource's unified v1 base URL (no
# trailing /responses or /chat/completions); model fields below must then
# hold the Azure *deployment name*, not a bare model ID.
# AZURE_FOUNDRY_ENDPOINT=https://<resource>.services.ai.azure.com/openai/v1
# AZURE_FOUNDRY_API_KEY=

# Model selection. Qwen3.5 4B/2B chosen for 6GB VRAM — checked against the
# live Ollama library (ollama.com/library) on 2026-06-22; Qwen2.5 was an
# earlier, stale recommendation. See docs/NL-KQL/PROJECT_STATUS.md §1.3.
# IR_BUILDER_LLM_MODEL also backs the System A baseline (same model required for a fair comparison).
DEFAULT_LLM_MODEL=qwen3.5:4b
IR_BUILDER_LLM_MODEL=qwen3.5:4b
EXTRACTION_LLM_MODEL=qwen3.5:2b
