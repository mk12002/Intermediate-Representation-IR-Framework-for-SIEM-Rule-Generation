# LLM provider — fixed once for the whole study (see docs/NL-KQL/MASTER_PLAN.md §20)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434

# Model selection. Qwen2.5 7B/3B chosen for 6GB VRAM (Q4_K_M quantization).
# IR_BUILDER_LLM_MODEL also backs the System A baseline (same model required for a fair comparison).
DEFAULT_LLM_MODEL=qwen2.5:7b-instruct
IR_BUILDER_LLM_MODEL=qwen2.5:7b-instruct
EXTRACTION_LLM_MODEL=qwen2.5:3b-instruct
