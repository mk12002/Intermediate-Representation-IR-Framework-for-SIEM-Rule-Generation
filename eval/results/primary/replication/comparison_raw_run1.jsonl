on": null, "system_b_warnings": [], "system_a_kql": "let TimeWindow = 5m;\nlet UserAgentThreshold = 3;\nweb_session\n| summarize UserAgentCount=dcount(HttpUserAgent), UserAgents=make_set(HttpUserAgent, 10) by SrcIpAddr, bin(TimeGenerated, TimeWindow)\n| where UserAgentCount > UserAgentThreshold"}
